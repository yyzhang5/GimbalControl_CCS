# ==============================================================================
# GimbalControl — Git 忽略规则（TI C2000 / CCS 双核工程）
# 说明：本文件只用 UTF-8 纯文本，不要用 GBK 保存
# 注意：git 不支持“行尾注释”，注释必须单独占一行
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CCS / TI 编译产物
# ------------------------------------------------------------------------------
# CCS 构建输出目录（以“构建配置名”命名，整个目录都是生成物）
Debug/
Release/
F2837x_RAM/
F2837x_FLASH/
# ↑ 以后在 CCS 里新建构建配置（Build Configuration）时，
#   把新的输出目录名补充到上面这几行

# 编译中间文件 / 输出文件
*.out
*.obj
*.pp
*.d
*.map
*.lst
*.opt
# 注：ccsObjs.opt / objects.mk / subdir_rules.mk / makefile 等
#     只出现在构建目录内，已被上面的目录规则覆盖

# CCS 链接产生的 <工程名>.xml / <工程名>_linkInfo.xml。
# 当前它们都位于构建目录内（已被覆盖），故默认不全局忽略 *.xml，
# 以免将来误伤源码目录中的 xml；若发现散落在外的生成 XML，取消下行注释。
# *.xml

# ------------------------------------------------------------------------------
# 2. CCS / Eclipse 工作区与用户级状态（非源码，勿提交）
# ------------------------------------------------------------------------------
/.metadata/
/.jxbrowser.userdata/
/dvt/
/RemoteSystemsTempFiles/
# CCS 调试启动配置：内含调试器实例名等本机信息，且历史遗留文件很多
.launches/
*.launch
# 如需共享个别调试配置，可用负向规则单独放行，例如：
# !.launches/BIT_SK_CCD_CPU1_ 0528.launch

# ------------------------------------------------------------------------------
# 3. 系统与编辑器
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*~
~$*
# 如需团队共享 C2000 的 IntelliSense 配置，可改为下面写法：
# .vscode/*
# !.vscode/c_cpp_properties.json
# !.vscode/settings.json
# !.vscode/ti_c28x_intellisense_shim.h

# ------------------------------------------------------------------------------
# 4. 日志与临时文件
# ------------------------------------------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.orig
*.rej
*.autosave
